{
  "name": "@mityu/fall-matcher-extended-substring",
  "version": "0.1.0",
  "exports": {
    ".": "./mod.ts"
  },
  "lock": false,
  "publish": {
    "include": [
      "**/*.ts",
      "LICENSE",
      "README.md"
    ],
    "exclude": [
      "*_test.ts"
    ]
  },
  "imports": {
    "@core/iterutil": "jsr:@core/iterutil@^0.9.0",
    "@denops/std": "jsr:@denops/std@^8.2.0",
    "@denops/test": "jsr:@denops/test@^4.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@vim-fall/custom": "jsr:@vim-fall/custom@^0.1.0",
    "@vim-fall/std": "jsr:@vim-fall/std@^0.14.0"
  },
  "tasks": {
    "check-all": "deno task check && deno task check:doc && deno task lint && deno task test",
    "check": "deno check --no-lock ./",
    "check:doc": "deno test --doc --no-run",
    "lint": "deno lint ./",
    "lint-fix": "deno lint --fix ./",
    "fmt": "deno fmt ./",
    "test": "deno test -A --doc --parallel --shuffle **/*.ts",
    "update": "deno outdated --update --latest"
  }
}
